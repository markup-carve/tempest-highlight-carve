{
    "name": "markup-carve/tempest-highlight-carve",
    "description": "Carve markup language support for tempest/highlight: server-side syntax highlighting for .crv source.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "carve",
        "markup",
        "highlight",
        "syntax-highlighting",
        "tempest",
        "crv"
    ],
    "authors": [
        {
            "name": "Mark Scherer",
            "homepage": "https://www.dereuromark.de"
        }
    ],
    "support": {
        "issues": "https://github.com/markup-carve/tempest-highlight-carve/issues",
        "source": "https://github.com/markup-carve/tempest-highlight-carve"
    },
    "require": {
        "php": ">=8.4",
        "tempest/highlight": "^2.28"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^4.0",
        "php-collective/code-sniffer": "^0.6",
        "dealerdirect/phpcodesniffer-composer-installer": "*"
    },
    "autoload": {
        "psr-4": {
            "MarkupCarve\\TempestHighlight\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MarkupCarve\\TempestHighlight\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
